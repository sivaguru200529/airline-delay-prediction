.env
!.env.example

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# pytest & coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
logs/
*.log

# Large Datasets (keep directories tracked via .gitkeep or README.md)
data/raw/*.csv
data/raw/*.parquet
data/raw/*.zip
data/raw/*.gz
!data/raw/README.md
!data/raw/.gitkeep

data/processed/*.csv
data/processed/*.parquet
!data/processed/.gitkeep

data/external/*
!data/external/.gitkeep

# Models and checkpoints
models/*.joblib
models/*.pkl
models/*.json
models/*.ubj
!models/.gitkeep

# OS specific
.DS_Store
Thumbs.db
