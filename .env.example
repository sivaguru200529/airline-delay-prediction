# ==============================================================================
# Airline Delay Prediction & Operations Analytics - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO

# Data Directories (Relative to project root or absolute paths)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_EXTERNAL_DIR=data/external
REPORTS_DIR=reports
MODELS_DIR=models

# Prediction & Business Logic
# Arrival delay in minutes to classify as delayed (default: 15 minutes as per FAA/BTS standard)
ARRIVAL_DELAY_THRESHOLD=15

# Risk Category Thresholds (predicted probabilities)
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_MEDIUM=0.60
RISK_THRESHOLD_HIGH=0.80

# Database Configuration (For Future PostgreSQL Phase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airline_analytics
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Configuration (For Future FastAPI Phase)
API_HOST=0.0.0.0
API_PORT=8000

# Weather API (For Future Weather Integration Phase)
# WEATHER_API_KEY=your_weather_api_key_here
# WEATHER_API_URL=https://api.weatherapi.com/v1
